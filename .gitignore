# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Team-4: 샌드박스(임시 제작용) 씬/폴더 — 실저장소에 커밋하지 않음
/[Aa]ssets/01.Scenes/Sandbox/
/[Aa]ssets/01.Scenes/Sandbox.meta
/[Aa]ssets/_Sandbox/
/[Aa]ssets/_Sandbox.meta

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# AI 글로벌 룰 (로컬 전용)
GEMINI.md

# 기획서 폴더 (로컬 전용)
/Docs/

# 에디터 스크린샷 (자동 생성)
/[Aa]ssets/[Ss]creenshots/

# Visual Studio 솔루션 (자동 생성)
*.slnx

# 던전 생성 디버그 덤프 (런타임 생성)
/[Aa]ssets/map_debug.txt
/[Aa]ssets/map_debug.txt.meta
# 개인 PC 전용 MCP 설정(경로가 사용자별이라 공유 금지)
.mcp.json

# 에셋스토어 에셋(공개 repo 재배포 금지) — 각자 임포트, repo에 미포함
/[Aa]ssets/FreePixelEffect/
/[Aa]ssets/FreePixelEffect.meta

# hera-agent 디버그 스크린샷
/Screenshots/

# 에셋스토어 사운드 (라이선스상 재배포 불가 — 팀원 각자 에셋스토어에서 무료로 받아 임포트)
/[Aa]ssets/A.M.P. DEMO/
/[Aa]ssets/A.M.P. DEMO.meta
/[Aa]ssets/Bow and Hammer Sound Effects/
/[Aa]ssets/Bow and Hammer Sound Effects.meta
# 위 에셋에서 자동 복사되는 클립 (ExternalSoundSync가 생성)
/[Aa]ssets/06.Sounds/Resources/99.External/
/[Aa]ssets/06.Sounds/Resources/99.External.meta
